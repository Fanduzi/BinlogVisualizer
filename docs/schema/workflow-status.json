              "required": [
                "exists",
                "path"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "execution": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
