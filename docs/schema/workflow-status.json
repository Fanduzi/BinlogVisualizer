          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "kind",
          "name",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "runtime_state": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "status": {
      "type": "string"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "items": {
              "additionalProperties": false,
