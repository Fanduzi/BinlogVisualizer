        "recommendations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "evidence_refs": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "anchor": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "section": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "anchor",
                    "label",
                    "section"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "kind": {
                "type": "string"
              },
              "priority": {
                "type": "string"
              },
              "related_finding_kinds": {
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
