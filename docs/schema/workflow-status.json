    "workflow_summary": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "evidence_refs": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "anchor": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "section": {
                      "type": "string"
                    }
