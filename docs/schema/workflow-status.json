              "source_report_label": {
                "type": "string"
              },
              "source_report_path": {
                "type": "string"
              },
              "source_step_kind": {
                "type": "string"
              },
              "source_step_name": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "priority",
              "related_finding_kinds",
              "source_report_label",
              "source_report_path",
              "source_step_kind",
              "source_step_name",
              "summary",
              "title"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "findings",
        "recommendations",
        "warnings"
      ],
      "type": "object"
    }
